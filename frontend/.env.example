# Port of the BoomrangChatFrontend Windows service (node .output\server\index.mjs).
# ops\start.bat keeps this in sync with FRONTEND_PORT at the top of the script.
FRONTEND_PORT=1235

# Where the frontend service forwards /api and /socket.io requests that reach it
# directly instead of through nginx, and where `npm run dev` proxies them.
# Leave empty on a normal install - ops\start.bat derives it from PORT and HOST in
# backend\.env. Only set it when the backend runs on a different machine.
BACKEND_ORIGIN=
