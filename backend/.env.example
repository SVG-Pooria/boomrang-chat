NODE_ENV=production
PORT=1234
HOST=0.0.0.0
CORS_ORIGINS=
DATABASE_URL=postgres://postgres:postgres@localhost:5432/boomrang
JWT_SECRET=
JWT_EXPIRES_IN=12h
PASSWORD_ENCRYPTION_KEY=
REDIS_URL=redis://127.0.0.1:6379
UPLOAD_DIR=./uploads
CLAMSCAN_ENABLED=true
CLAMSCAN_BIN=clamdscan
CLAMSCAN_TIMEOUT_MS=30000
CLAMSCAN_FAIL_OPEN=true
CLAMSCAN_AVAILABILITY_CACHE_MS=30000

# pg_dump used by the nightly (03:00) and on-demand backups in the super_admin
# panel. Leave empty to use pg_dump from PATH; on Windows the newest
# C:\Program Files\PostgreSQL\<version>\bin\pg_dump.exe is found automatically.
PG_DUMP_BIN=

# Folder that receives a copy of every uploaded file the moment it is stored.
# Downloads fall back to this copy if the original is missing, and permanent
# deletes in the super_admin panel remove it too. ops\start.bat adds this line
# with C:\boomrang_backup\files only when the line is missing and never overwrites a
# value you set yourself. An empty value turns the per-file mirror off.
BACKUP_MIRROR_FILES_DIR=C:\boomrang_backup\files

# Used only once, by `node src/db/seed.js`, to set the initial password for the
# two seeded super_admin accounts. If left unset, seed.js generates and prints
# a random one-time password instead. Both accounts must change their password
# on first login regardless.
SEED_SUPER_ADMIN_1_PASSWORD=
SEED_SUPER_ADMIN_2_PASSWORD=

# Optional interpretive layer for the channel summary box (خلاصهٔ هوشمند کانال).
# The summary is fully functional with this left disabled: every bullet is
# computed on this server from pinned messages, shared files, polls, tasks /
# approvals / meetings created from the conversation, unanswered questions and
# activity - no GPU, no model server and no internet access needed. When set to
# true, the backend may add at most two extra bullets from a model running on
# the organisation's own server through the OpenAI-compatible /chat/completions
# API (Ollama, vLLM, LM Studio and llama.cpp all expose it), e.g.
# http://127.0.0.1:11434/v1 for Ollama. Its output is validated and dropped on
# any malformed reply or timeout; محرمانه messages are never sent to it.
# SUMMARY_API_KEY is optional (local runtimes need none) and is only ever read
# by the backend - it never reaches the browser.
SUMMARY_MODEL_ENABLED=false
SUMMARY_API_BASE_URL=
SUMMARY_API_KEY=
SUMMARY_MODEL=
SUMMARY_TIMEOUT_MS=8000

# Used only by `npm run seed:qa`, which creates throwaway accounts for manual
# testing (09120000001, 09120000004-09120000006 employee / 09120000002
# management / 09120000003 super_admin). Refuses to run when
# NODE_ENV=production. Defaults to Boomrang!2024 if left unset.
SEED_QA_PASSWORD=
